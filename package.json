{
  "name": "offlinebrowsergames",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc --project tsconfig.server.json",
    "build-client": "npx webpack --mode=production",
    "build-client:dev": "npx webpack --mode=development",
    "build-client-nowatch:dev": "npx webpack --mode=development --no-watch",
    "build:dev": "tsc --project tsconfig.server.json --watch",
    "build-nowatch:dev": "tsc --project tsconfig.server.json",
    "eslint": "eslint src",
    "eslint-fix": "eslint --fix src",
    "start": "node dist/server/main.js",
    "start:dev": "nodemon --watch dist --watch static --exec \"node --enable-source-maps\" dist/server/main.js"
  },
  "dependencies": {
    "@types/three": "^0.185.0",
    "alea": "^1.0.1",
    "express": "^5.2.1",
    "parseurl": "^1.3.3",
    "send": "^1.2.1",
    "three": "^0.185.0",
    "webpack": "^5.108.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/parseurl": "^1.3.3",
    "@types/send": "^1.2.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "webpack-cli": "^7.1.0"
  }
}
